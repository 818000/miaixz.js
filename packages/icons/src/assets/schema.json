                "target": {
                  "const": 70
                },
                "tolerance": {
                  "const": 4
                }
              },
              "required": [
                "target",
                "tolerance"
              ],
              "type": "object"
            }
          },
          "required": [
            "compact",
            "standard",
            "display"
          ],
          "type": "object"
        }
