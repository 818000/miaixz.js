    "manifest": {
      "additionalProperties": false,
      "properties": {
        "categories": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "description": {
                "minLength": 1,
                "type": "string"
              },
              "id": {
                "pattern": "^[a-z]+$",
                "type": "string"
              }
            },
            "required": [
              "id",
              "description"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "shards": {
          "items": {
            "pattern": "^icons/f[0-9a-f]{4}-f[0-9a-f]{4}\\.json$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "categories",
        "shards"
      ],
      "type": "object"
    },
    "shard": {
      "additionalProperties": false,
      "properties": {
        "icons": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "category": {
                "pattern": "^[a-z]+$",
                "type": "string"
              },
              "codepoint": {
                "maximum": 1048573,
                "minimum": 983040,
                "type": "integer"
              },
              "name": {
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                "type": "string"
              },
              "opticalClass": {
                "enum": [
                  "regular",
                  "wide",
                  "tall",
                  "directional",
                  "compound",
                  "line-symbol"
                ]
              },
              "rtl": {
                "enum": [
                  "none",
                  "mirror"
                ]
              }
            },
            "required": [
              "name",
              "codepoint",
              "category",
              "opticalClass",
              "rtl"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "icons"
      ],
      "type": "object"
    },
