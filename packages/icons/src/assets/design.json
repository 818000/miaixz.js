{
  "font": {
    "familyName": "Miaixz Icons",
    "outputFile": "miaixz-icons.woff2",
    "unitsPerEm": 960
  },
  "axes": {
    "fill": {
      "tag": "FILL",
      "minimum": 0,
      "default": 0,
      "maximum": 1
    },
    "opticalSize": {
      "tag": "opsz",
      "minimum": 12,
      "default": 24,
      "maximum": 40
    }
  },
  "sizes": {
    "indicator": {
      "pixels": 12,
      "opticalSize": 12
    },
    "inline": {
      "pixels": 16,
      "opticalSize": 16
    },
    "control": {
      "pixels": 16,
      "opticalSize": 16
    },
    "navigation": {
      "pixels": 20,
      "opticalSize": 20
    },
    "feature": {
      "pixels": 24,
      "opticalSize": 24
    },
    "display": {
      "pixels": 32,
      "opticalSize": 32
    }
  },
  "grid": {
    "safeBounds": [
      60,
      -100,
      900,
      740
    ],
    "opticalCenter": [
      480,
      320
    ],
    "lengthTolerance": 2
  },
  "opticalClasses": {
    "regular": {
      "longestEdge": [
        680,
        800
      ],
      "centerTolerance": 29
    },
    "wide": {
      "longestEdge": [
        740,
        840
      ],
      "centerTolerance": 32
    },
    "tall": {
      "longestEdge": [
        740,
        840
      ],
      "centerTolerance": 32
    },
    "directional": {
      "longestEdge": [
        640,
        840
      ],
      "centerTolerance": 36
    },
    "compound": {
      "longestEdge": [
        720,
        840
      ],
      "centerTolerance": 32
    },
    "line-symbol": {
      "longestEdge": [
        560,
        800
      ],
      "centerTolerance": 29
    }
  },
  "limits": {
    "fontBytes": 524288,
    "runtimeBytes": 163840
  },
  "visual": {
    "strokeWidths": {
      "compact": {
        "target": 82,
        "tolerance": 6
      },
      "standard": {
        "target": 70,
        "tolerance": 4
      },
      "display": {
        "target": 62,
        "tolerance": 4
      }
    },
    "frameCornerRadius": {
      "standard": 40
    },
    "circleApproximationError": 0.5,
    "comparison": {
      "alphaThreshold": 128,
      "boundaryPixels": 1,
      "areaRelativeError": 0.05,
      "centroidPixels": 0.5,
      "paddingCssPixels": 2,
      "compiledOutlineUnits": 1,
      "subdivisionUnits": 0.05
    }
  }
}
