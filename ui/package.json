  "scripts": {
    "clean": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "icons:generate": "node src/icons/generate.mjs",
    "icons:check": "node src/icons/generate.mjs --check",
    "theme:generate": "node src/theme/generate.mjs",
    "theme:check": "node src/theme/generate.mjs --check",
    "responsive:generate": "node tests/generate-responsive-css.mjs",
    "responsive:check": "node tests/generate-responsive-css.mjs --check",
    "build": "npm run icons:check && npm run clean && tsc -p tsconfig.build.json && npm run theme:check && npm run responsive:check && node --input-type=module --eval \"import { cp } from 'node:fs/promises'; await cp('src/styles', 'dist/styles', { recursive: true }); await cp('src/theme', 'dist/theme', { recursive: true, filter: source => !/\\.(?:tsx?|mjs)$/.test(source) });\"",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src tests *.config.js",
    "lint:fix": "eslint src tests *.config.js --fix",
    "lint:css": "stylelint \"src/{styles,theme}/**/*.css\"",
    "lint:css:fix": "stylelint \"src/{styles,theme}/**/*.css\" --fix",
    "audit:css": "node tests/scripts/audit.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "check": "npm run typecheck && npm run lint && npm run lint:css && npm run audit:css && npm run test:coverage && npm run format:check"
  },
