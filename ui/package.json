  "scripts": {
    "clean": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node --input-type=module --eval \"import { cp } from 'node:fs/promises'; await cp('src/styles', 'dist/styles', { recursive: true });\"",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint src *.config.js",
    "lint:fix": "eslint src *.config.js --fix",
    "lint:css": "stylelint \"src/styles/**/*.css\"",
    "lint:css:fix": "stylelint \"src/styles/**/*.css\" --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run typecheck && npm run lint && npm run lint:css && npm run format:check",
    "pack:check": "npm run build && publint && attw --pack . && npm pack --dry-run"
  },
