{
  "name": "miaixz.js",
  "version": "0.6.5",
  "private": true,
  "packageManager": "npm@10.9.3",
  "description": "Build with intelligence. Create without limits.",
  "type": "module",
  "engines": {
    "node": ">=20.19",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/sdk",
    "packages/ui",
    "packages/view",
    "packages/icons"
  ],
  "scripts": {
    "version:set": "bash .github/scripts/version.sh",
    "version:check": "node .github/scripts/release/check-release-metadata.mjs",
    "headers:fix": "node .github/scripts/quality/enforce-source-policy.mjs --write",
    "headers:check": "node .github/scripts/quality/enforce-source-policy.mjs --check",
    "comments:check": "npm run headers:check && npm run lint",
    "icons:glyphs:write": "node .github/scripts/modules/icons/codegen/generate-glyphs.mjs --write",
    "icons:glyphs:check": "node .github/scripts/modules/icons/codegen/generate-glyphs.mjs --check",
    "icons:font:build": "node .github/scripts/modules/icons/fonts/build.mjs --write",
    "icons:font:check": "node .github/scripts/modules/icons/fonts/validate.mjs --mode source",
    "icons:font:inspect": "node .github/scripts/modules/icons/fonts/inspect.mjs --input packages/icons/dist/assets/fonts",
    "icons:font:render": "node .github/scripts/modules/icons/quality/visual/render-catalog.mjs --font-dir packages/icons/dist/assets/fonts --browser all",
    "icons:release:evidence": "node .github/scripts/modules/icons/quality/generate-release-evidence.mjs",
    "icons:dependencies:check": "node .github/scripts/modules/icons/quality/validate-dependencies.mjs",
    "build": "node .github/scripts/miaixz.mjs build",
    "typecheck": "node .github/scripts/miaixz.mjs typecheck",
    "lint": "node .github/scripts/miaixz.mjs lint && npm run lint:scripts",
    "lint:scripts": "eslint .github/scripts --config packages/ui/eslint.config.js",
    "lint:boundaries": "node .github/scripts/quality/audit-import-boundaries.mjs",
    "lint:fix": "node .github/scripts/miaixz.mjs lint:fix && npm run lint:scripts -- --fix",
    "audit:css": "npm run audit:css --workspace @miaixz/ui",
    "test:coverage": "node .github/scripts/miaixz.mjs test:coverage",
    "lockfile:check": "node .github/scripts/quality/check-lockfile.mjs",
    "plan:check": "node .github/scripts/quality/audit-adjustment-plan.mjs",
    "format": "npm run headers:fix && prettier . --write --ignore-unknown --config packages/ui/prettier.config.js --ignore-path .gitignore",
    "format:check": "prettier . --check --ignore-unknown --config packages/ui/prettier.config.js --ignore-path .gitignore",
    "check:static": "npm run comments:check && npm run lockfile:check && npm run version:check && npm run plan:check && npm run build && npm run typecheck && npm run lint:boundaries && npm run icons:dependencies:check && npm run audit:css && npm run test:coverage && npm run format:check",
    "check:browser": "npm run test:browser --workspace @miaixz/ui",
    "check:package": "node .github/scripts/package/check-packages.mjs",
    "check:clean": "node .github/scripts/quality/check-clean.mjs",
    "check": "npm run check:static && npm run check:browser && npm run check:package && npm run check:clean"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/818000/miaixz.js.git"
  },
  "bugs": {
    "url": "https://github.com/818000/miaixz.js/issues"
  },
  "homepage": "https://github.com/818000/miaixz.js#readme",
  "license": "Apache-2.0",
  "author": "The Miaixz Team",
  "devDependencies": {
    "@babel/parser": "8.0.4",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "saxes": "6.0.0",
    "svg-path-bbox": "2.1.0",
    "svg-pathdata": "7.2.0",
    "svgo": "4.1.0"
  }
}
