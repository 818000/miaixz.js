{
  "name": "miaixz.js",
  "version": "0.6.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "description": "Build with intelligence. Create without limits.",
  "type": "module",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "workspaces": [
    "sdk",
    "ui"
  ],
  "scripts": {
    "version:set": "bash .github/scripts/version.sh",
    "version:check": "node .github/scripts/check-release-metadata.mjs",
    "headers:fix": "node .github/scripts/enforce.js --write",
    "headers:check": "node .github/scripts/enforce.js --check",
    "build:sdk": "npm run build --workspace @miaixz/sdk",
    "build": "npm run build --workspace @miaixz/sdk && npm run build --workspace @miaixz/ui",
    "size": "npm run size --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:boundaries": "node .github/scripts/audit-import-boundaries.mjs",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "lint:css": "npm run lint:css --workspace @miaixz/ui",
    "audit:css": "npm run audit:css --workspace @miaixz/ui",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "lockfile:check": "node .github/scripts/check-lockfile.mjs",
    "plan:check": "node .github/scripts/audit-adjustment-plan.mjs",
    "format": "npm run headers:fix && prettier . --write --ignore-unknown --config ui/prettier.config.js --ignore-path .gitignore",
    "format:check": "prettier . --check --ignore-unknown --config ui/prettier.config.js --ignore-path .gitignore",
    "check:static": "npm run headers:check && npm run lockfile:check && npm run version:check && npm run plan:check && npm run build && npm run size && npm run typecheck && npm run lint && npm run lint:boundaries && npm run lint:css && npm run audit:css && npm run test:coverage && npm run format:check",
    "check:browser": "npm run test:browser --workspace @miaixz/ui",
    "check:package": "node .github/scripts/check-packages.mjs",
    "check:clean": "node .github/scripts/check-clean.mjs",
    "check": "npm run check:static && npm run check:browser && npm run check:package && npm run check:clean"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/818000/miaixz.js.git"
  },
  "bugs": {
    "url": "https://github.com/818000/miaixz.js/issues"
  },
  "homepage": "https://github.com/818000/miaixz.js#readme",
  "license": "Apache-2.0",
  "author": "The Miaixz Team",
  "devDependencies": {
    "@babel/parser": "8.0.4",
    "react18": "npm:react@18.3.1",
    "react-dom18": "npm:react-dom@18.3.1",
    "react-types18": "npm:@types/react@18.3.31",
    "react-dom-types18": "npm:@types/react-dom@18.3.7"
  }
}
